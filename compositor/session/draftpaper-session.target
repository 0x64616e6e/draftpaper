[Unit]
Description=Draftpaper session
Documentation=https://github.com/0x64616e6e/draftpaper
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
# the shell: the margins and the title block
Wants=draftpaper-shell.service
# idle: the displays off, locking (swayidle)
Wants=draftpaper-idle.service
# the sound as it was left (logging out mutes it)
Wants=draftpaper-audio.service
# the readings over time, for the graph
Wants=draftpaper-metrics.service
