#!/bin/sh
# draftpaper-greeter: Draftpaper's login screen, for greetd (/etc/greetd/config.toml:
#   [terminal] vt = 1
#   [default_session] command = "draftpaper-greeter", user = "_greetd").
# Runs the compositor as the login screen (--greeter) on the sheet of the user whose copy of it
# (`draftpaper apply`: /var/lib/draftpaper/greeter/<user>/) was written last, or of USER given as the
# argument, with their name filled in; without a copy, the default sheet. The session it starts is
# draftpaper-session (or another installed one, chosen with Tab: wayland-sessions), on the same VT, and
# the sheet stays on screen between the two.
dir=/var/lib/draftpaper/greeter
user=${1:-}
if [ -z "$user" ]; then
    last=$(ls -t "$dir"/*/.synced 2>/dev/null | head -n 1)
    [ -n "$last" ] && user=$(basename "$(dirname "$last")")
fi
look=
# only a copy its user owns (the directory is shared: anyone could make one under another's name)
if [ -n "$user" ] && [ -d "$dir/$user" ] && [ ! -L "$dir/$user" ] && [ "$(stat -c %U "$dir/$user")" = "$user" ]; then
    look=$dir/$user
fi
run=${XDG_RUNTIME_DIR:-/tmp}/draftpaper-greeter
mkdir -p "$run"
if [ -z "$look" ]; then
    look=$run/default
    mkdir -p "$look"
fi
# the compositor reads the sheet from HOME (the copy, not writable here); what the greeter writes itself
# (caches, Quickshell's state) goes to its runtime directory
export HOME="$look"
export XDG_CONFIG_HOME="$look/.config"
export DRAFTPAPER_CACHE="$look/.cache/draftpaper"
export XDG_CACHE_HOME="$run/cache"
export XDG_DATA_HOME="$run/data"
export XDG_STATE_HOME="$run/state"
mkdir -p "$XDG_STATE_HOME"
# where the login screen keeps the session each name chose last: greetd's own home (/var/lib/greetd,
# its user's alone), so the choice outlives a restart; without one it can write, the runtime state
greeter_home=$(getent passwd "$(id -u)" | cut -d: -f6)
if [ -n "$greeter_home" ] && [ -d "$greeter_home" ] && [ -w "$greeter_home" ]; then
    export DRAFTPAPER_GREETER_STATE="$greeter_home/.local/state/draftpaper"
    mkdir -p "$DRAFTPAPER_GREETER_STATE" || export DRAFTPAPER_GREETER_STATE="$XDG_STATE_HOME"
else
    export DRAFTPAPER_GREETER_STATE="$XDG_STATE_HOME"
fi
export DRAFTPAPER_GREETER_USER="$user"
export DRAFTPAPER_GREETER_SESSION="${DRAFTPAPER_GREETER_SESSION:-draftpaper-session}"
# its log (and the card's, and the holder's) to the journal: greetd keeps none (journalctl -t draftpaper-greeter)
export DRAFTPAPER_LOG="${DRAFTPAPER_LOG:-warn}"
exec systemd-cat --identifier=draftpaper-greeter draftpaper-compositor --tty --greeter
